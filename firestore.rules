rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: usuarios
    // Fields: uid, email, nome, tipo, ativo, createdAt, updatedAt
    // tipos: 'admin', 'gerente', 'barbeiro', 'cliente'
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSaaSAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == "barber@admin.ai" ||
          request.auth.token.email == "blsseparate7@gmail.com" ||
          (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'saas_admin' &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId == 'saas' &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true &&
           (request.auth.token.email == "barber@admin.ai" || request.auth.token.email == "blsseparate7@gmail.com"))
        );
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          isSaaSAdmin() ||
          request.auth.token.email == "blsseparate7@gmail.com" ||
          request.auth.token.email == "barbeariagbcortes7@gmail.com" ||
          request.auth.token.email == "gabriel.alexandre@gbcortes7.com" ||
          (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin' &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true)
        );
    }

    function isGerente() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'gerente' &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true)
        );
    }

    function isStaff() {
      return isAdmin() || isGerente();
    }

    function isBarbeiro() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'barbeiro' &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true)
        );
    }

    function hasRolePermission(permKey) {
      return isAuthenticated() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'saas_admin' ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/tenant_permissions/$(
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId == null || 
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId == "" ? 
            "gbcortes7" : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId
          )) ? 
          (get(/databases/$(database)/documents/tenant_permissions/$(
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId == null || 
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId == "" ? 
            "gbcortes7" : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tenantId
          )).data[get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo][permKey] == true) :
          (
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'gerente' ||
            (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'barbeiro' && (permKey == 'sell_subscription' || permKey == 'edit_clients'))
          )
        )
      );
    }

    // Rules for Test collection (connection test)
    match /test/{docId} {
      allow read: if isAuthenticated();
    }

    // Rules for Tenants (Multi-tenant units)
    match /tenants/{tenantId} {
      // Leitura individual (get) permitida para carregar identidade visual da barbearia no agendamento
      allow get: if true;

      // Listagem da coleção de tenants (list):
      // - Permitida para listagem de barbearias ativas (portal de agendamento online e clientes)
      // - Permitida para SaaS Admin (gestão global de tenants)
      // - Permitida para Staff da barbearia (consulta da própria unidade)
      // - Permitida para o dono da unidade localizando sua barbearia pelo email
      allow list: if isSaaSAdmin() ||
                     isStaff() ||
                     (resource != null && resource.data.isActive == true) ||
                     (isAuthenticated() && resource != null && (
                       resource.data.ownerEmail == request.auth.token.email ||
                       resource.data.email == request.auth.token.email
                     ));

      allow create: if isAuthenticated() && tenantId != 'saas' && (isSaaSAdmin() || !exists(/databases/$(database)/documents/tenants/$(tenantId)));
      allow update: if isStaff() || isSaaSAdmin();
      allow delete: if isSaaSAdmin();

      // Private settings / Asaas credentials subcollection
      match /private_settings/{docId} {
        allow read, write: if isStaff() || isSaaSAdmin();
      }
    }

    // Security & Financial Audit Logs
    match /financial_audit_logs/{logId} {
      allow read: if isStaff() || isSaaSAdmin();
      allow create, update: if isStaff() || isSaaSAdmin();
      allow delete: if isSaaSAdmin();
    }

    match /security_audit_logs/{logId} {
      allow read: if isStaff() || isSaaSAdmin();
      allow create, update: if isStaff() || isSaaSAdmin();
      allow delete: if isSaaSAdmin();
    }

    // Rules for Usuarios collection - BLINDADA CONTRA ESCALAÇÃO DE PRIVILÉGIOS E VAZAMENTO DE PII
    match /usuarios/{userId} {
      // Leitura de perfil individual:
      // - O próprio usuário acessando seu perfil
      // - Equipe da barbearia (Staff, SaaS Admin, Barbeiros)
      // - Qualquer pessoa lendo perfis de profissionais (barbeiros/gestores) para agendamento
      allow get: if (isAuthenticated() && request.auth.uid == userId) ||
                    isStaff() || 
                    isSaaSAdmin() || 
                    isBarbeiro() ||
                    (resource != null && resource.data.tipo in ['barbeiro', 'gerente', 'admin'] && resource.data.ativo == true);

      // Listagem da coleção de usuários:
      // - ESTRITAMENTE PROIBIDO para clientes comuns listarem a base inteira (fecha listagem em massa de PII)
      // - Permitido para Staff, SaaS Admin e Barbeiros
      // - Permitido para listagem exclusiva de profissionais (para catálogo de agendamento online)
      // - Permitido para consulta estrita pelo próprio e-mail autenticado (auto-healing de login)
      allow list: if isStaff() || 
                     isSaaSAdmin() || 
                     isBarbeiro() ||
                     (resource != null && resource.data.tipo in ['barbeiro', 'gerente', 'admin']) ||
                     (isAuthenticated() && resource != null && resource.data.email == request.auth.token.email);
      
      // Criação de perfil:
      // - SaaS Admin cria qualquer perfil
      // - Admin de unidade cria usuários da sua barbearia (exceto saas_admin)
      // - Auto-cadastro (signUp): OBRIGATORIAMENTE do tipo 'cliente' (bloqueia auto-promoção p/ gerente/barbeiro/admin)
      allow create: if isSaaSAdmin() ||
        (isAdmin() && request.resource.data.tipo != 'saas_admin' && request.resource.data.tenantId != 'saas') ||
        (
          isAuthenticated() && request.auth.uid == userId && 
          request.resource.data.tipo == 'cliente' && 
          request.resource.data.tenantId != 'saas'
        );

      // Atualização de perfil:
      // 1. SaaS Admin pode atualizar qualquer perfil
      // 2. Admin pode atualizar usuários da sua barbearia (sem conceder saas_admin)
      // 3. Usuário comum atualizando a si próprio:
      //    - ESTRITAMENTE PROIBIDO alterar permissões ('tipo', 'tenantId', 'ativo', 'bloqueado', 'bloqueadoParaAgendar', 'is_gestor', 'is_manager')
      //    - ESTRITAMENTE PROIBIDO alterar dados financeiros ('saldo_atual', 'total_gasto', 'total_pago', 'total_em_aberto', 'balance', 'totalSpent', 'totalPaid', 'pontos', 'points', 'cashback')
      //    - ESTRITAMENTE PROIBIDO alterar comissões e metas ('percentual_comissao', 'commission_percentage', 'remuneracao_fixa', 'monthly_goal', 'meta_mensal')
      // 4. Barbeiro atualizando dados de clientes:
      //    - Não pode alterar permissões nem saldo/cashback/financeiro do cliente
      allow update: if isSaaSAdmin() ||
        (isAdmin() && request.resource.data.tipo != 'saas_admin' && request.resource.data.tenantId != 'saas') ||
        (
          isAuthenticated() && request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'tipo', 'tenantId', 'ativo', 'bloqueado', 'bloqueadoParaAgendar', 'is_gestor', 'is_manager',
            'saldo_atual', 'total_gasto', 'total_pago', 'total_em_aberto', 'balance', 'totalSpent', 'totalPaid', 'pontos', 'points', 'cashback',
            'percentual_comissao', 'commission_percentage', 'remuneracao_fixa', 'monthly_goal', 'meta_mensal'
          ])
        ) ||
        (
          isBarbeiro() && resource != null && resource.data.tipo == 'cliente' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'tipo', 'tenantId', 'ativo', 'bloqueado', 'bloqueadoParaAgendar', 'is_gestor', 'is_manager',
            'saldo_atual', 'total_gasto', 'total_pago', 'total_em_aberto', 'balance', 'totalSpent', 'totalPaid', 'pontos', 'points', 'cashback'
          ])
        );
      
      allow delete: if isSaaSAdmin() || (isAdmin() && resource != null && resource.data.tipo != 'saas_admin' && resource.data.tipo != 'admin');

      // Subcoleção de anotações internas dos clientes
      match /anotacoes/{anotacaoId} {
        allow read: if isAuthenticated() && (isStaff() || isBarbeiro() || request.auth.uid == userId);
        allow create, update, delete: if isAuthenticated() && (isStaff() || isBarbeiro());
      }
    }

    // Rules for Services (Public read for online booking showcase)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /service_categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Rules for Appointments (Public read for slot calculation, authenticated create)
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow delete: if isStaff();
    }

    match /recurring_appointments/{appointmentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow delete: if isStaff();
    }

    match /agenda_blocks/{blockId} {
      allow read: if true;
      allow write: if isStaff() || isBarbeiro();
    }

    // Rules for Comandas
    match /comandas/{comandaId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    // --- Financeiro ---
    match /financial_transactions/{transactionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }
    
    match /cash_sessions/{sessionId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("manage_cash");
    }

    match /professional_advances/{advanceId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() ||
        (resource != null && resource.data.profissional_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    match /professional_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() ||
        (resource != null && resource.data.profissional_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    match /inconsistency_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() || isBarbeiro();
      allow update, delete: if isStaff();
    }

    match /cash_movements/{movementId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    match /professional_schedules/{barberId} {
      allow read: if true;
      allow write: if isStaff() || (isAuthenticated() && request.auth.uid == barberId);
    }
    
    match /financial_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /commissions/{commissionId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() ||
        (resource != null && resource.data.profissional_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    match /commission_payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        (resource != null && resource.data.profissional_id == request.auth.uid)
      );
      allow create, update: if isStaff();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    // --- Estoque ---
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isBarbeiro();
    }
    
    match /product_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    
    match /inventory_movements/{movementId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow create: if isStaff() || isBarbeiro();
      allow update, delete: if isStaff();
    }

    // --- Assinaturas ---
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isStaff() || isSaaSAdmin();
    }
    
    match /subscriptions/{subscriptionId} {
      allow read, get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff() || isSaaSAdmin();
    }
    
    match /subscription_usage/{usageId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /subscription_commission_runs/{runId} {
      allow read, write: if isStaff();
    }

    // --- Marketing e Automações ---
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isStaff();
    }
    
    match /marketing_automations/{automationId} {
      allow read, write: if isStaff();
    }
    
    match /marketing_history/{historyId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    match /automations/{automationId} {
      allow read, write: if isStaff();
    }
    
    match /automation_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
    }

    // --- Fidelidade ---
    match /loyalty_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /waitlist/{entryId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow create, update: if isAuthenticated();
      allow delete: if isStaff();
    }

    match /loyalty_points/{clientId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        clientId == request.auth.uid ||
        clientId.endsWith("_" + request.auth.uid) ||
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow write: if isStaff() || isBarbeiro();
    }
    
    match /loyalty_history/{historyId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow create: if isStaff() || isBarbeiro();
      allow update, delete: if isStaff();
    }

    // --- Insights e Sistema ---
    match /system_insights/{insightId} {
      allow read, write: if isStaff();
    }

    match /payment_methods/{methodId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isBarbeiro();
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isBarbeiro();
    }

    // --- Dívidas ---
    match /client_debts/{debtId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    match /debt_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && resource.data.cliente_id == request.auth.uid)
      );
      allow create, update: if isStaff() || isBarbeiro();
      allow delete: if isAdmin() || hasRolePermission("reopen_comanda");
    }

    // --- Novos Recursos de Relacionamento e Lembretes (Reminders) ---
    match /lembretes_internos/{reminderId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow write: if isAuthenticated() && (isStaff() || isBarbeiro());
    }

    match /noticias_noticias/{noticiaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaff();
    }

    match /noticias_campanhas/{campanhaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaff();
    }

    // --- Fidelidade e Relacionamento ---
    match /cupons_desconto/{cupomId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaff();
    }

    match /mensagens_modelos/{modeloId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow write: if isAuthenticated() && isStaff();
    }

    // --- Pesquisa de Satisfação ---
    match /pesquisa_perguntas/{perguntaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaff();
    }

    match /pesquisa_respostas/{respostaId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && isStaff();
    }

    // --- Pacotes e Planos Fidelidade ---
    match /pacotes_config/{pkgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaff();
    }

    match /pacotes_vendas/{vendaId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() || 
        (resource != null && (resource.data.clientId == request.auth.uid || resource.data.cliente_id == request.auth.uid))
      );
      allow create, update, delete: if isAuthenticated() && (isStaff() || isBarbeiro());
    }

    match /team_goals/{goalId} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro());
      allow write: if isAuthenticated() && (isStaff() || isBarbeiro());
    }

    // --- Auxiliares / Tipos Customizados ---
    match /tipos_categorias/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_pagamentos/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_despesas/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_receitas/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_contas/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_equipamentos/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_fornecedores/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_anamnese/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_bandeiras/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_deducoes/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }
    match /tipos_mensagens/{id} { allow read: if isAuthenticated(); allow write: if isAuthenticated() && isStaff(); }

    // --- Avaliações / Reviews ---
    match /avaliacoes/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isStaff() || (resource != null && resource.data.cliente_id == request.auth.uid));
    }

    // --- Daily Operations Flow ---
    match /daily_flow/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isStaff() || isBarbeiro());
    }

    // --- Accounts Payable / Receivables (Financeiro) ---
    match /accounts_payable/{id} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        (resource != null && resource.data.profissional_id == request.auth.uid)
      );
      allow write: if isAuthenticated() && isStaff();
    }

    match /accounts_receivable/{id} {
      allow read, write: if isAuthenticated() && isStaff();
    }

    // --- Client Ledger Notes ---
    match /client_ledger_notes/{id} {
      allow read: if isAuthenticated() && (isStaff() || isBarbeiro() || (resource != null && resource.data.cliente_id == request.auth.uid));
      allow create, update, delete: if isAuthenticated() && (isStaff() || isBarbeiro());
    }

    // --- Assinaturas (Alternative collection name used in migrate) ---
    match /assinaturas/{subscriptionId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        isBarbeiro() ||
        (resource != null && resource.data.cliente_id == request.auth.uid) ||
        (resource != null && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isStaff() || request.resource.data.clientId == request.auth.uid);
      allow update: if isStaff() || (
        isAuthenticated() && 
        resource != null && 
        (resource.data.cliente_id == request.auth.uid || resource.data.clientId == request.auth.uid)
      );
      allow delete: if isAdmin() || hasRolePermission("delete_subscription");
    }

    // --- Tenant Permissions ---
    match /tenant_permissions/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- In-App Notifications ---
    match /notifications/{notificationId} {
      allow read, list: if isAuthenticated() && (
        isStaff() ||
        isBarbeiro() ||
        (resource != null && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'admin'))
      );
      allow create: if true;
      allow update: if isAuthenticated() && (
        isStaff() ||
        (resource != null && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'admin'))
      );
      allow delete: if isAuthenticated() && isStaff();
    }

    // --- SaaS Plans ---
    match /saas_plans/{planId} {
      allow read: if true;
      allow write: if isSaaSAdmin();
    }

    // --- SaaS Settings ---
    match /saas_settings/{settingId} {
      allow read: if true;
      allow write: if isSaaSAdmin();
    }
  }
}
